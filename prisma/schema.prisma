// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}


enum Rank {
  OWNER
  GM 
  OFFICER
  MEMBER 

}
enum Spec {
  PROT_PALADIN
  PROT_WARRIOR
  BEAR
  HOLY_PALADIN
  RETRI_PALADIN
  HOLY_PRIEST
  SHADOW_PRIEST
  DISC_PRIEST
  BLOOD_DK
  FROST_DK 
  UNHOLY_DK 
  BM_HUNTER
  MM_HUNTER 
  SURV_HUNTER
  FROST_MAGE
  FIRE_MAGE
  ARCANE_MAGE
  FERAL_DRUID
  BALANCE_DRUID
  RESTO_DRUID
  RESTO_SHAMAN
  ENHA_SHAMAN
  ELE_SHAMAN
  COMBAT_ROGUE
  ASSASSIN_ROGUE
  SUB_ROGUE
  FURY_WARRIOR
  ARMS_WARRIOR
  DEMO_WARLOCK
  AFFLI_WARLOCK
  DESTRO_WARLOCK
}
enum Status {
  ACTIVE
  TENTATIVE
  ABSENCE
  BENCH
  LATE
}
model User {
   id Int @id @default(autoincrement())
   discordId String @unique
   guildMembers GuildMember[]

}
model Guild {
 id Int @id @default(autoincrement())
 name String
 createdAt DateTime @default(now())
 updateAt DateTime @updatedAt
  member GuildMember []
  dkp  DkpImport[]
  signup Signup[]
  discordGuildId String @unique
  list BisList[]
}

model GuildMember {
  id Int @id @default(autoincrement())
  rank  Rank
  userId Int 
  user User @relation(fields: [userId], references: [id])
  guildId Int
  guild  Guild @relation(fields : [guildId], references: [id])
  chars  Character []
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  slug String @unique
  dkp Int @default(0)
  @@unique([guildId , userId])
}

model Character {
  id  Int @id @default(autoincrement())
  name String 
  @@unique([guildMemberId, name])
  spec Spec
  isMain Boolean @default(false)
  guildMemberId Int
  playerSignups PlayerSignup[]
  guildMember GuildMember @relation(fields: [guildMemberId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


}

model DkpImport {
  id Int @id @default(autoincrement())
  dkpImport String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  guildId Int
  guild Guild @relation(fields: [guildId], references: [id])

}
model Signup {
 id Int @id @default(autoincrement())
 title String
 date  String
 note String
 leader  String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 playerSignups PlayerSignup[]
 guildId Int
 guild Guild @relation(fields: [guildId], references: [id])
 discordMessageId String?
 discordChannelId String
}
model BisList {
  id Int @id @default(autoincrement())
  guildId Int
  guild  Guild @relation(fields: [guildId], references: [id])
  title String
  spec Spec
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  imgUrl String
}
model PlayerSignup {
  id Int  @id @default(autoincrement())
  characterId Int
  character Character @relation(fields: [characterId], references: [id])
  signupId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  signup Signup @relation(fields: [signupId], references: [id])
  status Status
  @@unique([signupId , characterId])
}